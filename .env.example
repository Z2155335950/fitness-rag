# OpenAI or any provider exposing an OpenAI-compatible Chat Completions API.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Leave empty for OpenAI. For another compatible provider, set its /v1 URL.
LLM_BASE_URL=

# Optional request timeout in seconds.
LLM_TIMEOUT=45

# Optional for DeepSeek only: enabled or disabled. Other providers ignore it.
LLM_THINKING=enabled

# Recommended in production. If empty, the app creates db/.auth_secret.
APP_SECRET_KEY=
APP_COOKIE_SECURE=false

# DeepSeek official API example:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
